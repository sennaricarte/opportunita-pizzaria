---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mascote from '../components/Mascote.astro';
import Parceiros from '../components/Parceiros.astro';
import StatsBand from '../components/StatsBand.astro';
import { rasterFormats } from '../utils/image';
import { CARDAPIO_URL, INSCRICAO_URL, WHATSAPP_PEDIDOS_URL } from '../config/site';

import heroImage from '../assets/images/hero-opportunita.jpg';

const whatsappUrl = WHATSAPP_PEDIDOS_URL;
const cardapioUrl = CARDAPIO_URL;

const pizzasDestaque = (await getCollection('pizzas')).filter((p) => p.data.destaque);
const depoimentos = await getCollection('depoimentos');
const escolaDaPizza = await getEntry('projetos', 'escola-da-pizza');
const turmasEscola = (await getCollection('turmas')).filter((turma) => turma.data.publicado === true);
const formadosEscola = turmasEscola.reduce((total, turma) => total + turma.data.formados, 0);
const pessoasFormadas =
  formadosEscola === 1
    ? '1 pessoa já formada'
    : `${formadosEscola.toLocaleString('pt-BR')} pessoas já formadas`;
const turmasTexto =
  turmasEscola.length === 1 ? '1 turma' : `${turmasEscola.length.toLocaleString('pt-BR')} turmas`;
---

<Base
  title="Pizzaria social em Poá, no Alto Tietê"
  description="Pizzaria social em Poá, no Alto Tietê, com delivery artesanal na Vila Açoreana. 100% do lucro financia a Escola da Pizza e os projetos do Instituto Recomeçar."
>
  <!-- HERO -->
  <section class="hero hero--home" aria-labelledby="hero-titulo">
    <div class="hero__inner hero__inner--split container">
      <div class="hero__content">
        <h1 id="hero-titulo" class="hero__title">Sabor que transforma vidas</h1>
        <p class="hero__subtitle">
          A Opportunità é uma pizzaria social em Poá. Cada pedido gera trabalho,
          capacitação e oportunidades — e <strong>100% do lucro</strong> financia os
          projetos do Instituto Recomeçar. A
          <a href="/escola-da-pizza">Escola da Pizza</a> é aberta a moradores de
          todo o Alto Tietê e mantém, na origem do Instituto, o compromisso com
          egressos do sistema prisional e seus familiares.
        </p>
        <div class="hero__actions">
          <a
            class="btn btn--primary"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Peça sua pizza (abre em nova aba)"
          >
            Peça sua pizza
          </a>
          <a class="btn btn--outline" href="/instituto-recomecar">
            Conheça nossa causa
          </a>
        </div>
      </div>

      <figure class="hero__figure">
        <Image
          src={heroImage}
          alt="Homem sorrindo segura a caixa verde da Opportunità Pizzaria Social, com a mensagem de que ao comer a pizza você colabora com projetos sociais"
          width={1024}
          height={768}
          widths={[400, 800, 1024]}
          formats={rasterFormats(heroImage)}
          quality="mid"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="media-cover hero__photo"
        />
      </figure>
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="como" aria-labelledby="como-titulo">
    <div class="container">
      <div class="como__intro">
        <div class="como__lead">
          <h2 id="como-titulo" class="section-title">Como funciona</h2>
          <p>
            A Opportunità não é um negócio à parte: é a extensão da
            <a href="/escola-da-pizza">Escola da Pizza</a> e o motor econômico dos
            projetos sociais no Alto Tietê.
          </p>
        </div>
        <Mascote variant="delivery" size="md" class="como__mascote" />
      </div>
      <ol class="como__steps">
        <li class="como__step">
          <span class="como__numero" aria-hidden="true">1</span>
          <p class="como__text">
            Moradores do Alto Tietê se inscrevem na
            <a href="/escola-da-pizza">Escola da Pizza</a>.
          </p>
        </li>
        <li class="como__step">
          <span class="como__numero" aria-hidden="true">2</span>
          <p class="como__text">Aprendem na cozinha da Opportunità.</p>
        </li>
        <li class="como__step">
          <span class="como__numero" aria-hidden="true">3</span>
          <p class="como__text">Cada pizza vendida gera renda e oportunidades na região.</p>
        </li>
        <li class="como__step">
          <span class="como__numero" aria-hidden="true">4</span>
          <p class="como__text">
            100% do lucro financia novas turmas e os projetos do
            <a href="/instituto-recomecar">Instituto Recomeçar</a>.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <StatsBand headingId="impacto-titulo" />

  <!-- PIZZAS EM DESTAQUE -->
  <section class="destaques" aria-labelledby="destaques-titulo">
    <div class="container">
      <div class="destaques__header">
        <h2 id="destaques-titulo" class="section-title">Pizzas em destaque</h2>
        <a
          class="destaques__link"
          href={cardapioUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ver cardápio completo (abre em nova aba)"
        >
          Ver cardápio completo
        </a>
      </div>

      <ul class="destaques__grid">
        {
          pizzasDestaque.map((pizza) => (
            <li>
              <article class="pizza-card">
                <span class="pizza-card__badge">{pizza.data.categoria}</span>
                <h3 class="pizza-card__nome">{pizza.data.nome}</h3>
                <p class="pizza-card__desc">{pizza.data.descricao}</p>
              </article>
            </li>
          ))
        }
      </ul>

      <a
        class="btn btn--secondary"
        href={cardapioUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Explorar cardápio (abre em nova aba)"
      >
        Explorar cardápio
      </a>
    </div>
  </section>

  <!-- ESCOLA DA PIZZA -->
  {
    escolaDaPizza && (
      <section class="escola" aria-labelledby="escola-titulo">
        <div class="container escola__inner">
          <div class="escola__copy">
            <h2 id="escola-titulo" class="section-title">{escolaDaPizza.data.titulo}</h2>
            <p class="escola__texto">{escolaDaPizza.data.resumo}</p>
            {
              formadosEscola > 0 && (
                <p class="escola__resultado">
                  <a href="/escola-da-pizza#resultados">
                    {pessoasFormadas} em {turmasTexto}
                  </a>
                </p>
              )
            }
            <div class="escola__actions">
              <a
                class="btn btn--primary"
                href={INSCRICAO_URL}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Inscreva-se (abre em nova aba)"
              >
                Inscreva-se
              </a>
              <a class="btn btn--outline-dark" href="/escola-da-pizza">
                Conheça a Escola da Pizza
              </a>
            </div>
          </div>
          <Mascote variant="chef" size="md" class="escola__mascote" />
        </div>
      </section>
    )
  }

  <Parceiros compact headingId="parceiros-home" />

  <!-- DEPOIMENTOS -->
  <section class="depoimentos" aria-labelledby="depoimentos-titulo">
    <div class="container">
      <h2 id="depoimentos-titulo" class="section-title">Depoimentos</h2>
      <p class="depoimentos__hint">Deslize para ver mais</p>

      <ul class="depoimentos__track" role="list">
        {
          depoimentos.map((item) => (
            <li class="depoimentos__card">
              <blockquote>
                <p class="depoimentos__texto">&ldquo;{item.data.texto}&rdquo;</p>
                <footer class="depoimentos__autor">
                  <cite class="depoimentos__nome">{item.data.nome}</cite>
                  <span class="depoimentos__papel">{item.data.papel}</span>
                </footer>
              </blockquote>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="cta-final" aria-labelledby="cta-final-titulo">
    <div class="container cta-final__inner cta-with-mascote">
      <Mascote variant="moto" size="lg" class="cta-final__mascote" />
      <div class="cta-final__copy">
        <h2 id="cta-final-titulo" class="cta-final__title">
          Quem compra uma pizza da Opportunità, constrói pontes.
        </h2>
        <a
          class="btn btn--light"
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Peça sua pizza pelo WhatsApp (abre em nova aba)"
        >
          Peça sua pizza
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero__photo {
    object-position: top center;
  }

  /* Como funciona */
  .como {
    padding-block: var(--space-8);
  }

  .como__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    margin-bottom: var(--space-2);
  }

  .como__lead {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 42rem;
  }

  .como__lead p {
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .como__lead a,
  .como__text a {
    color: var(--verde);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .como__mascote {
    align-self: center;
  }

  .como__steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .como__step {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    column-gap: var(--space-4);
    align-items: start;
  }

  .como__step:not(:last-child) {
    padding-bottom: var(--space-6);
  }

  .como__numero {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background-color: var(--verde);
    color: var(--branco);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1;
  }

  .como__step:not(:last-child)::after {
    content: '';
    position: absolute;
    z-index: 0;
    top: 3.5rem;
    bottom: 0;
    left: 1.75rem;
    width: 2px;
    background-color: rgb(27 107 58 / 35%);
    transform: translateX(-50%);
  }

  .como__text {
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--preto);
  }

  /* Pizzas em destaque */
  .destaques {
    padding-block: var(--space-8);
  }

  .destaques__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .destaques__link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--verde);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .destaques__grid {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .pizza-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background-color: var(--branco);
    border-radius: var(--radius);
    border: 1px solid rgb(27 107 58 / 12%);
    height: 100%;
  }

  .pizza-card__badge {
    align-self: flex-start;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: capitalize;
    color: var(--verde-escuro);
    background-color: rgb(244 180 0 / 25%);
    border-radius: 999px;
  }

  .pizza-card__nome {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--verde-escuro);
  }

  .pizza-card__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--preto);
    opacity: 0.85;
  }

  /* Escola da Pizza */
  .escola {
    padding-block: var(--space-8);
    background-color: var(--branco);
    border-block: 1px solid rgb(27 107 58 / 10%);
  }

  .escola__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: center;
  }

  .escola__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .escola__texto {
    font-size: var(--text-base);
    max-width: 60ch;
    line-height: 1.7;
  }

  .escola__resultado {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .escola__resultado a {
    color: var(--verde);
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .escola__resultado a:hover,
  .escola__resultado a:focus-visible {
    color: var(--verde-escuro);
  }

  .escola__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Depoimentos */
  .depoimentos {
    padding-block: var(--space-8);
  }

  .depoimentos__hint {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--preto);
    opacity: 0.6;
  }

  .depoimentos__track {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding-bottom: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-2);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--verde) transparent;
  }

  .depoimentos__card {
    flex: 0 0 min(88%, 22rem);
    scroll-snap-align: start;
  }

  .depoimentos__card blockquote {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-5);
    background-color: var(--branco);
    border-radius: var(--radius);
    border-left: 4px solid var(--verde);
    box-shadow: 0 2px 12px rgb(0 0 0 / 6%);
  }

  .depoimentos__texto {
    font-size: var(--text-base);
    font-style: italic;
    line-height: 1.7;
    flex: 1;
  }

  .depoimentos__autor {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .depoimentos__nome {
    font-size: var(--text-sm);
    font-weight: 600;
    font-style: normal;
    color: var(--verde-escuro);
  }

  .depoimentos__papel {
    font-size: var(--text-sm);
    color: var(--preto);
    opacity: 0.7;
  }

  /* CTA final */
  .cta-final {
    padding-block: var(--space-8);
    background-color: var(--vermelho);
    color: var(--branco);
  }

  .cta-final__inner {
    gap: var(--space-6);
  }

  .cta-final__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .cta-final__title {
    font-size: var(--text-2xl);
    font-weight: 600;
    max-width: 28ch;
  }

  /* Tablet+ */
  @media (min-width: 40rem) {
    .como__intro {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .como__mascote {
      align-self: auto;
    }

    .cta-final__copy {
      align-items: flex-start;
    }

    .destaques__header {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
    }

    .destaques__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .depoimentos__card {
      flex-basis: min(45%, 22rem);
    }

    .escola__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 64rem) {
    .como__steps {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-5);
    }

    .como__step {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: var(--space-4);
      min-width: 0;
    }

    .como__step:not(:last-child) {
      padding-bottom: 0;
    }

    .como__step:not(:last-child)::after {
      top: 1.75rem;
      bottom: auto;
      left: 3.5rem;
      width: calc(100% - 3.5rem + var(--space-5));
      height: 2px;
      transform: translateY(-50%);
    }

    .como__text {
      padding-top: 0;
    }

    .cta-final__title {
      font-size: var(--text-3xl);
      max-width: 36ch;
    }
  }
</style>
