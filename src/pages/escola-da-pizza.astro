---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mascote from '../components/Mascote.astro';
import GraficoBarras from '../components/GraficoBarras.astro';
import { rasterFormats } from '../utils/image';
import { getAncoraResultados, INSCRICAO_URL, WHATSAPP_INSTITUCIONAL } from '../config/site';
import fotoMassa from '../assets/images/escola/massa-aluna.jpg';
import fotoAbertura from '../assets/images/escola/abertura-massa.jpg';
import fotoMontagem from '../assets/images/escola/montagem-pizza.jpg';
import fotoTurma from '../assets/images/escola/turma.jpg';
import fotoEquipe from '../assets/images/escola/pratica-equipe.jpg';
import fotoRecheio from '../assets/images/escola/recheio-catupiry.jpg';

const galeria = [
  {
    src: fotoTurma,
    alt: 'Turma da Escola da Pizza com aventais da Opportunità, Instituto Recomeçar e Pizza Prime',
  },
  {
    src: fotoMassa,
    alt: 'Aluna da Escola da Pizza trabalha a massa na cozinha da Opportunità',
  },
  {
    src: fotoAbertura,
    alt: 'Aluno abre a massa de pizza sobre a pá de madeira na aula prática',
  },
  {
    src: fotoMontagem,
    alt: 'Alunos montam uma pizza com queijo e recheio na bancada da cozinha',
  },
  {
    src: fotoEquipe,
    alt: 'Equipe da Escola da Pizza coloca coberturas juntos sobre a massa',
  },
  {
    src: fotoRecheio,
    alt: 'Pizzaiolo da Escola da Pizza aplica recheio cremoso sobre a pizza na cozinha',
  },
] as const;

const turmas = (await getCollection('turmas'))
  .filter((turma) => turma.data.publicado === true)
  .sort((a, b) => {
    const porData = a.data.conclusao.getTime() - b.data.conclusao.getTime();
    return porData !== 0 ? porData : a.data.numero - b.data.numero;
  });

const temResultados = turmas.length > 0;
const ancoraResultados = await getAncoraResultados();

const totalFormados = turmas.reduce((total, turma) => total + turma.data.formados, 0);
const mostrarNumeros = totalFormados > 0;
const cidadesAtendidas = [
  ...new Set(turmas.flatMap((turma) => turma.data.cidades ?? []).map((cidade) => cidade.trim()).filter(Boolean)),
];

let acumulado = 0;
const formadosPorTurma = turmas.map((turma) => ({
  rotulo: turma.data.nome,
  valor: turma.data.formados,
}));
const formadosAcumulados = turmas.map((turma) => {
  acumulado += turma.data.formados;
  return { rotulo: turma.data.nome, valor: acumulado };
});

const turmasRecentes = [...turmas].sort((a, b) => b.data.conclusao.getTime() - a.data.conclusao.getTime());

function mesAno(data: Date) {
  return data.toLocaleDateString('pt-BR', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}

const whatsappEmpresas = `https://wa.me/${WHATSAPP_INSTITUCIONAL}?text=${encodeURIComponent(
  'Olá! Sou empresa e gostaria de contratar formandos da Escola da Pizza.',
)}`;

const pilares = [
  {
    titulo: 'Capacitação Profissional',
    descricao:
      'Massas, molhos, montagem e técnicas de pizzaria com prática intensiva na cozinha da Opportunità, com certificação ao final do programa.',
    icon: 'capacitacao',
  },
  {
    titulo: 'Desenvolvimento Pessoal',
    descricao:
      'Habilidades socioemocionais, gestão financeira e preparo para o mercado de trabalho, com acompanhamento individualizado.',
    icon: 'desenvolvimento',
  },
  {
    titulo: 'Inserção no Mercado',
    descricao:
      'Parcerias com empresas para contratação de formandos e apoio a quem deseja empreender no setor gastronômico.',
    icon: 'insercao',
  },
] as const;

const cidadesAltoTiete = [
  'Poá',
  'Suzano',
  'Ferraz de Vasconcelos',
  'Itaquaquecetuba',
  'Mogi das Cruzes',
  'Arujá',
  'Guararema',
  'Biritiba Mirim',
  'Salesópolis',
  'Santa Isabel',
] as const;

const publico = [
  {
    titulo: 'Moradores do Alto Tietê',
    descricao: 'Quem quer uma profissão na gastronomia, sem experiência prévia.',
  },
  {
    titulo: 'Egressos do sistema prisional e seus familiares',
    descricao: 'A origem do nosso trabalho e o compromisso central do Instituto Recomeçar.',
  },
  {
    titulo: 'Quem quer empreender',
    descricao: 'Quem deseja abrir o próprio negócio de alimentação.',
  },
] as const;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://opportunitapizzaria.com.br';
const courseDescription =
  'Curso de pizzaiolo gratuito no Alto Tietê, com prática real na Opportunità em Poá. Aberto a toda a comunidade.';

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Escola da Pizza',
  description: courseDescription,
  url: new URL('/escola-da-pizza', siteUrl).href,
  provider: {
    '@type': 'Organization',
    name: 'Instituto Recomeçar',
    url: new URL('/instituto-recomecar', siteUrl).href,
  },
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'BRL',
  },
  areaServed: cidadesAltoTiete.map((cidade) => ({
    '@type': 'City',
    name: cidade,
  })),
};

const faq = [
  {
    pergunta: 'O programa tem custo?',
    resposta:
      'Não. A Escola da Pizza é totalmente gratuita. O programa é financiado pelo lucro da Opportunità Pizzaria Social, revertido integralmente para o Instituto Recomeçar.',
  },
  {
    pergunta: 'Qual a duração do curso?',
    resposta:
      'O curso dura uma semana, com aulas teóricas e prática intensiva na cozinha da Opportunità.',
  },
  {
    pergunta: 'Há certificado ao final?',
    resposta:
      'Sim. Os formandos que concluem o programa recebem certificação de capacitação profissional em panificação e pizzaria, reconhecendo as competências técnicas desenvolvidas.',
  },
  {
    pergunta: 'Como faço para me inscrever?',
    resposta:
      'A inscrição é feita pelo formulário online, seguida de entrevista para conhecer seu perfil e disponibilidade.',
  },
  {
    pergunta: 'Preciso ter experiência na cozinha?',
    resposta:
      'Não é necessária experiência prévia. O programa foi pensado para quem está começando do zero, com acompanhamento próximo da equipe pedagógica em todas as etapas.',
  },
] as const;
---

<Base
  title="Curso de Pizzaiolo Gratuito no Alto Tietê | Escola da Pizza em Poá"
  description={courseDescription}
  appendSiteName={false}
  extraSchema={courseSchema}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Escola da Pizza', path: '/escola-da-pizza' },
  ]}
>
  <!-- Hero -->
  <section class="hero hero--green" aria-labelledby="hero-titulo">
    <div class="container hero__inner hero__inner--mascote">
      <div>
        <p class="hero__eyebrow">Formação profissional gratuita</p>
        <h1 id="hero-titulo" class="hero__title">Escola da Pizza</h1>
        <p class="hero__subtitle">
          Programa gratuito aberto a moradores de todo o Alto Tietê, com prática real na
          Opportunità, em Poá.
        </p>
        <div class="hero__actions">
          <a
            class="btn btn--primary"
            href={INSCRICAO_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Quero me inscrever (abre em nova aba)"
          >
            Quero me inscrever
          </a>
          <a class="btn btn--outline-light" href={ancoraResultados}>
            Ver resultados
          </a>
        </div>
      </div>
      <Mascote variant="chef" size="lg" priority />
    </div>
  </section>

  {
    temResultados && (
  <section class="resultados" id="resultados" aria-labelledby="resultados-titulo">
    <div class="container">
      <h2 id="resultados-titulo" class="section-title">Nossos resultados</h2>

      {
        mostrarNumeros && (
          <>
            <ul class="resultados__cards" role="list">
              <li class="resultados__card">
                <p class="resultados__numero">{totalFormados.toLocaleString('pt-BR')}</p>
                <p class="resultados__rotulo">
                  {totalFormados === 1 ? 'pessoa formada' : 'pessoas formadas'}
                </p>
              </li>
              <li class="resultados__card">
                <p class="resultados__numero">{turmas.length.toLocaleString('pt-BR')}</p>
                <p class="resultados__rotulo">{turmas.length === 1 ? 'turma' : 'turmas'}</p>
              </li>
              {
                cidadesAtendidas.length > 0 && (
                  <li class="resultados__card">
                    <p class="resultados__numero">{cidadesAtendidas.length.toLocaleString('pt-BR')}</p>
                    <p class="resultados__rotulo">
                      {cidadesAtendidas.length === 1 ? 'cidade atendida' : 'cidades atendidas'}
                    </p>
                  </li>
                )
              }
            </ul>

            <div class="resultados__graficos">
              <div>
                <h3 class="resultados__subtitulo">Formados por turma</h3>
                <GraficoBarras
                  dados={formadosPorTurma}
                  titulo="Formados por turma"
                  descricao="Quantidade de pessoas formadas em cada turma da Escola da Pizza, da mais antiga para a mais recente."
                  colunaRotulo="Turma"
                  colunaValor="Formados"
                />
              </div>
              <div>
                <h3 class="resultados__subtitulo">Total acumulado</h3>
                <GraficoBarras
                  dados={formadosAcumulados}
                  titulo="Total acumulado de formados"
                  descricao="Total acumulado de pessoas formadas ao longo das turmas, da mais antiga para a mais recente."
                  colunaRotulo="Turma"
                  colunaValor="Total acumulado"
                />
              </div>
            </div>
          </>
        )
      }

      <h3 class="resultados__subtitulo resultados__subtitulo--turmas">Nossas turmas</h3>
      <ul class="turmas" role="list">
        {
          turmasRecentes.map((turma) => {
            const foto = turma.data.fotos[0];
            return (
              <li>
                <article class="turma-card">
                  <div class="turma-card__midia">
                    <Image
                      src={foto.src}
                      alt={foto.alt}
                      width={foto.src.width}
                      height={foto.src.height}
                      widths={[400, 600, 800]}
                      formats={rasterFormats(foto.src)}
                      quality="mid"
                      loading="lazy"
                      decoding="async"
                      class="media-cover"
                    />
                  </div>
                  <div class="turma-card__corpo">
                    <h4 class="turma-card__nome">{turma.data.nome}</h4>
                    <p class="turma-card__meta">{mesAno(turma.data.conclusao)}</p>
                    {
                      turma.data.formados > 0 && (
                        <p class="turma-card__meta">
                          {turma.data.formados.toLocaleString('pt-BR')}{' '}
                          {turma.data.formados === 1 ? 'formado' : 'formados'}
                        </p>
                      )
                    }
                  </div>
                </article>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
    )
  }

  <!-- O que você aprende -->
  <section class="pilares" aria-labelledby="pilares-titulo">
    <div class="container">
      <h2 id="pilares-titulo" class="section-title">O que você aprende</h2>
      <ul class="pilares__grid" role="list">
        {
          pilares.map(({ titulo, descricao, icon }) => (
            <li class="pilares__card">
              <span class="pilares__icon" aria-hidden="true">
                {icon === 'capacitacao' && (
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="2"/>
                    <path d="M16 28l6-8 5 5 7-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                )}
                {icon === 'desenvolvimento' && (
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 8v32M8 24h32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <circle cx="24" cy="24" r="10" stroke="currentColor" stroke-width="2"/>
                    <path d="M24 18v12M18 24h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                )}
                {icon === 'insercao' && (
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="8" y="20" width="32" height="20" rx="3" stroke="currentColor" stroke-width="2"/>
                    <path d="M16 20V14a8 8 0 0116 0v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M24 28v4M20 30h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                )}
              </span>
              <h3 class="pilares__heading">{titulo}</h3>
              <p class="pilares__text">{descricao}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="galeria" id="na-pratica" aria-labelledby="galeria-titulo">
    <div class="container">
      <h2 id="galeria-titulo" class="section-title">Na prática</h2>
      <p class="galeria__intro">
        Aulas na cozinha da Opportunità: massa, abertura, montagem e o convívio da turma.
      </p>
      <ul class="galeria__grid" role="list">
        {
          galeria.map(({ src, alt }) => (
            <li class="galeria__item media-slot media-slot--3-4">
              <Image
                src={src}
                alt={alt}
                width={src.width}
                height={src.height}
                widths={[400, 600, 768]}
                formats={rasterFormats(src)}
                quality="mid"
                loading="lazy"
                decoding="async"
                class="media-cover"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Aberta à comunidade -->
  <section class="publico" aria-labelledby="publico-titulo">
    <div class="container">
      <h2 id="publico-titulo" class="section-title">Aberta a toda a comunidade do Alto Tietê</h2>
      <p class="publico__intro">
        A formação recebe quem mora em Poá, Suzano, Ferraz de Vasconcelos, Itaquaquecetuba,
        Mogi das Cruzes, Arujá, Guararema, Biritiba Mirim, Salesópolis e Santa Isabel.
      </p>
      <ul class="publico__grid" role="list">
        {
          publico.map(({ titulo, descricao }) => (
            <li>
              <article class="publico__card">
                <h3 class="publico__heading">{titulo}</h3>
                <p class="publico__text">{descricao}</p>
              </article>
            </li>
          ))
        }
      </ul>

      <aside class="publico__essencia" aria-labelledby="essencia-titulo">
        <h3 id="essencia-titulo" class="publico__essencia-titulo">Nossa essência</h3>
        <p>
          O Instituto Recomeçar nasceu para a reintegração de egressos e acompanha o
          desenvolvimento de quem passa pela formação mesmo depois do curso.
        </p>
      </aside>

      <aside class="publico__info" aria-label="Informações sobre o processo seletivo">
        <p>
          <strong>Processo seletivo por inscrição e entrevista.</strong> Não é necessária
          experiência prévia na cozinha — buscamos comprometimento, disponibilidade e vontade
          de recomeçar.
        </p>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" aria-labelledby="faq-titulo">
    <div class="container">
      <h2 id="faq-titulo" class="section-title">Perguntas frequentes</h2>
      <div class="faq__list">
        {
          faq.map(({ pergunta, resposta }) => (
            <details class="faq__item">
              <summary class="faq__pergunta">{pergunta}</summary>
              {
                pergunta === 'Como faço para me inscrever?' ? (
                  <p class="faq__resposta">
                    A inscrição é feita pelo{' '}
                    <a
                      href={INSCRICAO_URL}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="formulário online (abre em nova aba)"
                    >
                      formulário online
                    </a>
                    , seguida de entrevista para conhecer seu perfil e disponibilidade.
                  </p>
                ) : (
                  <p class="faq__resposta">{resposta}</p>
                )
              }
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta" aria-labelledby="cta-titulo">
    <div class="container cta__inner">
      <h2 id="cta-titulo" class="cta__title">Pronto para recomeçar?</h2>
      <p class="cta__text">
        Inscreva-se no programa ou entre em contato se sua empresa deseja contratar formandos.
      </p>
      <div class="cta__actions">
        <a
          class="btn btn--primary"
          href={INSCRICAO_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Quero me inscrever (abre em nova aba)"
        >
          Quero me inscrever
        </a>
        <a
          class="btn btn--outline-light"
          href={whatsappEmpresas}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Falar no WhatsApp para contratar formandos da Escola da Pizza (abre em nova aba)"
        >
          Sou empresa e quero contratar formandos
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .resultados {
    padding-block: var(--space-8);
    background-color: var(--branco);
  }

  .resultados__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .resultados__card {
    padding: var(--space-5);
    background-color: var(--creme);
    border-radius: var(--radius);
    border: 1px solid rgb(27 107 58 / 12%);
  }

  .resultados__numero {
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1.1;
    color: var(--verde);
  }

  .resultados__rotulo {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--verde-escuro);
  }

  .resultados__graficos {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    margin-top: var(--space-7);
  }

  .resultados__subtitulo {
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--verde-escuro);
  }

  .resultados__subtitulo--turmas {
    margin-top: var(--space-7);
  }

  .turmas {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .turma-card {
    overflow: hidden;
    background-color: var(--creme);
    border: 1px solid rgb(27 107 58 / 12%);
    border-radius: var(--radius);
  }

  .turma-card__midia {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .turma-card__corpo {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .turma-card__nome {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--verde-escuro);
  }

  .turma-card__meta {
    font-size: var(--text-sm);
    color: var(--preto);
  }

  @media (min-width: 40rem) {
    .resultados__cards {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }

    .turmas {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .turmas {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Pilares */
  .pilares {
    padding-block: var(--space-8);
  }

  .pilares__grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .pilares__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background-color: var(--branco);
    border-radius: var(--radius);
    border: 1px solid rgb(27 107 58 / 12%);
  }

  .pilares__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    color: var(--verde);
    background-color: rgb(27 107 58 / 8%);
    border-radius: var(--radius);
  }

  .pilares__heading {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--verde-escuro);
  }

  .pilares__text {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--preto);
    opacity: 0.85;
  }

  .galeria {
    padding-block: var(--space-8);
    background-color: var(--branco);
    border-block: 1px solid rgb(27 107 58 / 10%);
  }

  .galeria__intro {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--preto);
    opacity: 0.75;
    max-width: 52ch;
  }

  .galeria__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .galeria__item {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 2px 12px rgb(0 0 0 / 8%);
  }

  /* Público */
  .publico {
    padding-block: var(--space-8);
  }

  .publico__grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .publico__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    height: 100%;
    background-color: var(--creme);
    border-radius: var(--radius);
    border-top: 4px solid var(--verde);
  }

  .publico__heading {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--verde-escuro);
  }

  .publico__intro {
    margin-top: var(--space-3);
    max-width: 62ch;
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .publico__text {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--preto);
    opacity: 0.85;
  }

  .publico__essencia {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background-color: var(--verde-escuro);
    color: var(--branco);
    border-radius: var(--radius);
  }

  .publico__essencia-titulo {
