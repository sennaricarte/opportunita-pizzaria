---
import Base from '../layouts/Base.astro';
import {
  AREAS_ENTREGA,
  CARDAPIO_URL,
  HORARIO_FUNCIONAMENTO,
  WHATSAPP_PEDIDOS_URL,
} from '../config/site';

// Sem tempo de entrega, taxa ou pedido mínimo: publicar só com confirmação do cliente.
---

<Base
  title="Delivery de Pizza em Poá, Suzano e Região | Opportunità"
  appendSiteName={false}
  description="Delivery de pizza artesanal da Opportunità em Poá, Suzano, Itaquaquecetuba, Ferraz de Vasconcelos e Cidade Kemel. Veja horário e como pedir."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Delivery de pizza em Poá', path: '/delivery-pizza-poa/' },
  ]}
>
  <section class="hero hero--green" aria-labelledby="hero-titulo">
    <div class="container hero__inner hero__inner--narrow">
      <p class="hero__eyebrow">Pizza artesanal com propósito</p>
      <h1 id="hero-titulo" class="hero__title">Delivery de pizza em Poá</h1>
      <p class="hero__subtitle">
        A Opportunità entrega pizza artesanal a partir da Vila Açoreana, em Poá, e em cidades
        do Alto Tietê. Cada pedido gera trabalho e 100% do lucro financia o Instituto Recomeçar.
      </p>
      <div class="delivery__acoes">
        <a
          class="btn btn--primary"
          href={WHATSAPP_PEDIDOS_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Pedir pizza pelo WhatsApp (abre em nova aba)"
        >
          Pedir pelo WhatsApp
        </a>
        <a
          class="btn btn--outline"
          href={CARDAPIO_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Pedir na Brendi (abre em nova aba)"
        >
          Pedir na Brendi
        </a>
      </div>
    </div>
  </section>

  <section class="bloco" aria-labelledby="areas-titulo">
    <div class="container">
      <h2 id="areas-titulo" class="section-title">Onde entregamos</h2>
      <ul class="bloco__lista" role="list">
        {AREAS_ENTREGA.map((area) => <li>{area}</li>)}
      </ul>
      <p class="bloco__texto">
        Cidade Kemel fica em Poá. Moramos na região e atendemos quem está perto da sede, na
        Av. Vital Brasil, 478, Vila Açoreana.
      </p>
    </div>
  </section>

  <section class="bloco bloco--alt" aria-labelledby="horario-titulo">
    <div class="container">
      <h2 id="horario-titulo" class="section-title">Horário de funcionamento</h2>
      <ul class="bloco__lista bloco__lista--texto" role="list">
        {HORARIO_FUNCIONAMENTO.map(({ dias, horas }) => <li>{dias}: {horas}</li>)}
      </ul>
    </div>
  </section>

  <section class="bloco" aria-labelledby="como-titulo">
    <div class="container">
      <h2 id="como-titulo" class="section-title">Como pedir</h2>
      <ol class="bloco__passos">
        <li>
          Escolha os sabores no <a href="/cardapio/">cardápio de pizzas</a>.
        </li>
        <li>
          Peça pelo
          <a href={WHATSAPP_PEDIDOS_URL} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp (11) 96244-8909 (abre em nova aba)">WhatsApp (11) 96244-8909</a>
          ou pelo
          <a href={CARDAPIO_URL} target="_blank" rel="noopener noreferrer" aria-label="cardápio digital na Brendi (abre em nova aba)">cardápio digital na Brendi</a>.
        </li>
        <li>
          Se preferir, ligue para <a href="tel:+551146341149">(11) 4634-1149</a>.
        </li>
      </ol>
      <p class="bloco__texto">
        Mais sobre a pizzaria: <a href="/sobre/">história da Opportunità</a> e
        <a href="/contato/">contato completo</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .delivery__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .bloco {
    padding-block: var(--space-8);
  }

  .bloco--alt {
    background-color: var(--branco);
    border-block: 1px solid rgb(27 107 58 / 10%);
  }

  .bloco__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .bloco__lista li {
    padding: var(--space-2) var(--space-4);
    font-weight: 600;
    color: var(--verde-escuro);
    background-color: var(--branco);
    border: 1px solid rgb(27 107 58 / 15%);
    border-radius: var(--radius);
  }

  .bloco__lista--texto {
    flex-direction: column;
  }

  .bloco__lista--texto li {
    padding: 0;
    font-weight: 400;
    color: inherit;
    background: none;
    border: 0;
    font-size: var(--text-base);
  }

  .bloco__texto,
  .bloco__passos {
    margin-top: var(--space-4);
    max-width: 62ch;
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .bloco__passos {
    padding-left: 1.25rem;
    list-style: decimal;
  }

  .bloco a {
    color: var(--verde);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
