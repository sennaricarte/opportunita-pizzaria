---
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoSchema from '../components/SeoSchema.astro';
import logoOg from '../assets/images/logo-opportunita.png';
import '../styles/global.css';
import '../styles/components.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-600.css';
import poppinsLatin400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2';

export interface BreadcrumbItem {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  appendSiteName?: boolean;
  extraSchema?: Record<string, unknown> | null;
}

const { title, description, ogImage, breadcrumbs, appendSiteName = true, extraSchema = null } = Astro.props;

const siteName = 'Opportunità Pizzaria Social';
const fullTitle = appendSiteName ? `${title} | ${siteName}` : title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const defaultOg = await getImage({ src: logoOg, width: 1024, height: 769 });
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site)
  : new URL(defaultOg.src, Astro.site);
const ogImageWidth = ogImage ? '1200' : String(defaultOg.attributes.width);
const ogImageHeight = ogImage ? '630' : String(defaultOg.attributes.height);

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1B6B3A" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      rel="preload"
      href={poppinsLatin400}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <SeoSchema isHome={isHome} breadcrumbs={breadcrumbs} extra={extraSchema} />
  </head>
  <body>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
