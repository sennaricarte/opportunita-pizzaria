---
import Logo from './Logo.astro';
import Mascote from './Mascote.astro';
import { WHATSAPP_PEDIDOS_URL } from '../config/site';

const whatsappUrl = WHATSAPP_PEDIDOS_URL;
const instagramUrl = 'https://www.instagram.com/opportunita.pizzaria.social/';
const facebookUrl = 'https://www.facebook.com/opportunita.pizzaria.social';
const recomecarUrl = 'https://www.recomecar360.org';
---

<footer class="footer">
  <div class="footer__inner container">
    <a href="/" class="footer__logo" aria-label="Opportunità Pizzaria Social — página inicial">
      <Logo variant="footer" />
    </a>
    <p class="footer__tagline">Sabor que transforma vidas</p>

    <ul class="footer__social">
      <li>
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram @opportunita.pizzaria.social (abre em nova aba)"
        >
          Instagram
        </a>
      </li>
      <li>
        <a
          href={facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook @opportunita.pizzaria.social (abre em nova aba)"
        >
          Facebook
        </a>
      </li>
    </ul>
    <p class="footer__handle">@opportunita.pizzaria.social</p>

    <ul class="footer__contacts">
      <li>
        <a href="tel:+551146341149">(11) 4634-1149</a>
      </li>
      <li>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp (11) 96244-8909 (abre em nova aba)">
          WhatsApp (11) 96244-8909
        </a>
      </li>
      <li>
        <a href="mailto:contato@opportunitapizzaria.com.br">
          contato@opportunitapizzaria.com.br
        </a>
      </li>
    </ul>

    <address class="footer__address">
      Av. Vital Brasil, 478<br />
      Vila Açoreana — Poá — SP
    </address>

    <p class="footer__mission">
      100% do lucro é revertido para o
      <a href={recomecarUrl} target="_blank" rel="noopener noreferrer" aria-label="Instituto Recomeçar (abre em nova aba)">
        Instituto Recomeçar
      </a>, que reintegra egressos do sistema prisional.
    </p>
    <p class="footer__instituto">
      Conheça o trabalho de reintegração social promovido pelo instituto parceiro.
      <a
        class="footer__link"
        href={recomecarUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="www.recomecar360.org (abre em nova aba)"
      >
        www.recomecar360.org
      </a>
    </p>

    <p class="footer__links">
      <a href="/sobre">Sobre a Opportunità</a>
      <a href="/seja-patrocinador">Seja um patrocinador</a>
    </p>

    <Mascote variant="chef" size="sm" class="footer__mascote" />

    <p class="footer__copy">
      &copy; {new Date().getFullYear()} Opportunità Pizzaria Social. Todos os direitos reservados.
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    background-color: var(--verde-escuro);
    color: var(--branco);
    padding-block: var(--space-8);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .footer__logo {
    display: inline-block;
    line-height: 0;
    text-decoration: none;
  }

  .footer__tagline {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--amarelo);
  }

  .footer__mission,
  .footer__instituto {
    max-width: 42ch;
    font-size: var(--text-sm);
    line-height: 1.7;
    opacity: 0.9;
  }

  .footer__mission a {
    color: var(--amarelo);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer__mascote {
    margin-top: var(--space-2);
  }

  .footer__address {
    font-style: normal;
    font-size: var(--text-sm);
    line-height: 1.7;
    opacity: 0.9;
  }

  .footer__contacts,
  .footer__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .footer a {
    color: var(--branco);
    text-decoration: none;
  }

  .footer a:hover,
  .footer a:focus-visible {
    color: var(--amarelo);
    outline: none;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer__handle {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    opacity: 0.8;
  }

  .footer__link {
    display: inline-block;
    margin-top: var(--space-2);
    font-weight: 500;
  }

  .footer__copy {
    width: 100%;
    margin-top: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 15%);
    font-size: var(--text-sm);
    opacity: 0.75;
  }

  @media (min-width: 40rem) {
    .footer__contacts,
    .footer__links {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-4);
    }
  }
</style>
